<Window x:Class="Udc.App.Views.CustomerDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer"
        Height="620" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" x:Name="TitleText" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,2" />
        <TextBlock DockPanel.Dock="Top" x:Name="CodeText" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16" />

        <Button DockPanel.Dock="Bottom" Content="Close" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Margin="0,16,0,0" Click="CloseButton_Click" />

        <Border x:Name="ErrorBanner" DockPanel.Dock="Top" Background="{StaticResource ErrorBgBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentPanel">
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Wallet balance" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="WalletText" FontSize="19" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Outstanding" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock x:Name="OutstandingText" FontSize="19" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel x:Name="FieldsPanel" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
