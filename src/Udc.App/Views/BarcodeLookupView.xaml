<UserControl x:Class="Udc.App.Views.BarcodeLookupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <StackPanel Margin="24" MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="Barcode Lookup" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4" />
        <TextBlock Text="Scan a tag, or type the barcode and press Enter." FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16" />

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="BarcodeBox" FontSize="16" Padding="10" KeyDown="BarcodeBox_KeyDown" />
            <Button Grid.Column="2" Content="Look Up" Style="{StaticResource PrimaryButton}" Click="LookUpButton_Click" />
        </Grid>

        <Border x:Name="ErrorBanner" Background="{StaticResource ErrorBgBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,16" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
        </Border>

        <Border x:Name="ResultCard" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Visibility="Collapsed">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="GarmentText" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                    <Border Grid.Column="1" Background="{StaticResource PrimaryBrush}" CornerRadius="12" Padding="12,5">
                        <TextBlock x:Name="StatusText" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </Grid>
                <StackPanel x:Name="FieldsPanel" />
                <Button Content="Print Tag" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="PrintTagButton_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
