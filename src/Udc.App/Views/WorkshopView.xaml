<UserControl x:Class="Udc.App.Views.WorkshopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Workshop" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="TabQueue" Content="Queue" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="TabQueue_Click" />
            <Button x:Name="TabSchedule" Content="Schedule" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="TabSchedule_Click" />
            <Button x:Name="TabReport" Content="Report" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="TabReport_Click" />
            <Button x:Name="TabBilling" Content="Billing" Style="{StaticResource SecondaryButton}" Click="TabBilling_Click" />
        </StackPanel>

        <ContentControl x:Name="SubContentArea" />
    </DockPanel>
</UserControl>
