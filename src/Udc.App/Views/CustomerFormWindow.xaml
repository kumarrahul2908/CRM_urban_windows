<Window x:Class="Udc.App.Views.CustomerFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Customer"
        Height="680" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" x:Name="HeaderText" Text="New Customer" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="CancelButton_Click" />
            <Button x:Name="SaveButton" Content="Save Customer" Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" />
        </StackPanel>

        <Border x:Name="ErrorBanner" DockPanel.Dock="Top" Background="{StaticResource ErrorBgBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="Title" />
                        <ComboBox x:Name="TitleBox" SelectedIndex="0">
                            <ComboBoxItem Content="Mr" /><ComboBoxItem Content="Mrs" /><ComboBoxItem Content="Ms" /><ComboBoxItem Content="Dr" /><ComboBoxItem Content="M/s" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="Full name *" />
                        <TextBox x:Name="FullNameBox" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="Mobile *" />
                        <TextBox x:Name="MobileBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="Alt. mobile" />
                        <TextBox x:Name="AltMobileBox" />
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,10">
                    <Label Content="Email" />
                    <TextBox x:Name="EmailBox" />
                </StackPanel>

                <StackPanel Margin="0,0,0,10">
                    <Label Content="Address" />
                    <TextBox x:Name="AddressBox" />
                </StackPanel>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="Area" />
                        <TextBox x:Name="AreaBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="City" />
                        <TextBox x:Name="CityBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <Label Content="Pincode" />
                        <TextBox x:Name="PincodeBox" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Content="Discount %" />
                        <TextBox x:Name="DiscountBox" Text="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Label Content="Communication" />
                        <ComboBox x:Name="CommunicationBox" SelectedIndex="0">
                            <ComboBoxItem Content="SMS" /><ComboBoxItem Content="WhatsApp" /><ComboBoxItem Content="Email" /><ComboBoxItem Content="None" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="HomeDeliveryBox" Content="Offers home delivery" Margin="0,0,0,10" />
                <CheckBox x:Name="ActiveBox" Content="Active" IsChecked="True" Margin="0,0,0,10" Visibility="Collapsed" />

                <StackPanel Margin="0,0,0,10">
                    <Label Content="Remarks" />
                    <TextBox x:Name="RemarksBox" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
