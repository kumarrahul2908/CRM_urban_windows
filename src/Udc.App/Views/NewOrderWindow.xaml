<Window x:Class="Udc.App.Views.NewOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Order"
        Height="860" Width="960"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="New Order" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16" />

        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Border x:Name="EstimateBar" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="EstimateText" VerticalAlignment="Center" FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Column="1" x:Name="EstimateTotalText" VerticalAlignment="Center" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="CancelButton_Click" />
                <Button x:Name="CreateOrderButton" Content="Create Order" Style="{StaticResource PrimaryButton}" Click="CreateOrderButton_Click" />
            </StackPanel>
        </StackPanel>

        <Border x:Name="ErrorBanner" DockPanel.Dock="Top" Background="{StaticResource ErrorBgBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,14" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Customer -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="CUSTOMER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />

                        <StackPanel x:Name="CustomerSearchPanel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="CustomerSearchBox" KeyDown="CustomerSearchBox_KeyDown" />
                                <Button Grid.Column="2" Content="Find" Style="{StaticResource SecondaryButton}" Click="CustomerSearchButton_Click" />
                            </Grid>
                            <ListBox x:Name="CustomerResultsList" MaxHeight="140" Margin="0,8,0,0" Visibility="Collapsed" MouseDoubleClick="CustomerResultsList_MouseDoubleClick" />
                        </StackPanel>

                        <Border x:Name="SelectedCustomerCard" Background="{StaticResource BgBrush}" CornerRadius="8" Padding="12" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="SelectedCustomerText" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SelectedCustomerSubText" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Change" Style="{StaticResource SecondaryButton}" Click="ChangeCustomerButton_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Store (only when the user has no fixed store) -->
                <Border x:Name="StoreCard" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="STORE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />
                        <ComboBox x:Name="StoreBox" DisplayMemberPath="StoreName" />
                    </StackPanel>
                </Border>

                <!-- Add items -->
                <Border x:Name="ItemsCard" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16" IsEnabled="False">
                    <StackPanel>
                        <TextBlock Text="ADD ITEMS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />

                        <TextBox x:Name="GarmentSearchBox" Margin="0,0,0,8" TextChanged="GarmentSearchBox_TextChanged" />

                        <DataGrid x:Name="GarmentsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="160" Margin="0,0,0,10"
                                  SelectionChanged="GarmentsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Garment" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="Service" />
                                <ComboBox x:Name="ServiceBox" DisplayMemberPath="ServiceName" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Quantity" />
                                <TextBox x:Name="QuantityBox" Text="1" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                                <Button Content="Add to Cart" Style="{StaticResource PrimaryButton}" Click="AddToCartButton_Click" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="Brand (optional)" />
                                <ComboBox x:Name="BrandBox" DisplayMemberPath="BrandName" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Color (optional)" />
                                <ComboBox x:Name="ColorBox" DisplayMemberPath="ColorName" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <Label Content="Remarks (optional)" />
                                <TextBox x:Name="ItemRemarksBox" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" x:Name="ManualOverrideBox" Content="Manual rate override" VerticalAlignment="Center" Checked="ManualOverrideBox_CheckedChanged" Unchecked="ManualOverrideBox_CheckedChanged" />
                            <StackPanel Grid.Column="2" x:Name="OverrideRatePanel" IsEnabled="False">
                                <Label Content="Override rate" />
                                <TextBox x:Name="OverrideRateBox" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Cart -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="CART" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />
                        <DataGrid x:Name="CartGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="140" Margin="0,0,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Garment" Binding="{Binding GarmentName}" Width="2*" />
                                <DataGridTextColumn Header="Service" Binding="{Binding ServiceName}" Width="1.5*" />
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="55" />
                                <DataGridTextColumn Header="Rate" Binding="{Binding Rate}" Width="70" />
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="80" />
                                <DataGridTextColumn Header="Brand" Binding="{Binding BrandName}" Width="*" />
                                <DataGridTextColumn Header="Color" Binding="{Binding ColorName}" Width="*" />
                                <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="1.5*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Content="Remove Selected Line" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="RemoveCartLineButton_Click" />
                    </StackPanel>
                </Border>

                <!-- Order details -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="ORDER DETAILS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="Due date" />
                                <DatePicker x:Name="DueDatePicker" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Urgent level" />
                                <ComboBox x:Name="UrgentLevelBox" DisplayMemberPath="LevelName" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="Discount type" />
                                <ComboBox x:Name="DiscountTypeBox" SelectedIndex="0">
                                    <ComboBoxItem Content="Percent" /><ComboBoxItem Content="Flat" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Discount value" />
                                <TextBox x:Name="DiscountValueBox" Text="0" TextChanged="DiscountValueBox_TextChanged" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="HomeDeliveryBox" Content="Home delivery" Margin="0,0,0,10" Checked="HomeDeliveryBox_CheckedChanged" Unchecked="HomeDeliveryBox_CheckedChanged" />
                        <StackPanel x:Name="DeliveryChargePanel" Width="150" HorizontalAlignment="Left" Margin="0,0,0,10" Visibility="Collapsed">
                            <Label Content="Delivery charge" />
                            <TextBox x:Name="DeliveryChargeBox" Text="0" />
                        </StackPanel>

                        <Label Content="Notes" />
                        <TextBox x:Name="NotesBox" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Payment (optional) -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="PAYMENT (OPTIONAL)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                        <TextBlock x:Name="WalletBalanceText" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label Content="Payment method" />
                                <ComboBox x:Name="PaymentTypeBox" DisplayMemberPath="TypeName" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Amount" />
                                <TextBox x:Name="PaymentAmountBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                                <Button Content="Add Line" Style="{StaticResource SecondaryButton}" Click="AddPaymentLineButton_Click" />
                            </StackPanel>
                        </Grid>

                        <DataGrid x:Name="PaymentLinesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Height="90" Margin="0,0,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Method" Binding="{Binding TypeName}" Width="2*" />
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Content="Remove Selected Line" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,0,0,8" Click="RemovePaymentLineButton_Click" />

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="PaymentSummaryText" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                            <StackPanel Grid.Column="2">
                                <Label Content="Wallet amount" />
                                <TextBox x:Name="WalletAmountBox" Text="0" TextChanged="WalletAmountBox_TextChanged" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
