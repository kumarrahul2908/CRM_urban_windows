<Window x:Class="Udc.App.Views.RecordPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record Payment"
        Height="360" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Record Payment" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,2" />
        <TextBlock DockPanel.Dock="Top" x:Name="DueText" FontSize="12.5" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="CancelButton_Click" />
            <Button x:Name="SubmitButton" Content="Record Payment" Style="{StaticResource PrimaryButton}" Click="SubmitButton_Click" />
        </StackPanel>

        <Border x:Name="ErrorBanner" DockPanel.Dock="Top" Background="{StaticResource ErrorBgBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" />
        </Border>

        <StackPanel>
            <Label Content="Payment method" />
            <ComboBox x:Name="PaymentTypeBox" DisplayMemberPath="TypeName" Margin="0,0,0,12" />

            <Label Content="Amount" />
            <TextBox x:Name="AmountBox" Margin="0,0,0,4" />
            <TextBlock Text="Leave at the full due amount, or enter a partial payment." FontSize="11" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>
    </DockPanel>
</Window>
